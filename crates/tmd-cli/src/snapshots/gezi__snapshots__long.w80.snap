长代码块
────────────────────────────────────────────────────────────────────────────────

下面的代码块超过 80 行，流式输出时应该一行一行出现：

                                                                            rust
use std::collections::HashMap;                                                  
                                                                                
/// 统计单词出现的次数。                                                        
pub fn word_count(text: &str) -> HashMap<String, usize> {                       
    let mut counts = HashMap::new();                                            
    for word in text.split_whitespace() {                                       
        *counts.entry(word.to_lowercase()).or_insert(0) += 1;                   
    }                                                                           
    counts                                                                      
}                                                                               
                                                                                
fn step_1(input: &[i64]) -> i64 {                                               
    // 第 1 步：过滤、映射再求和                                                
    input.iter().filter(|x| **x % 2 == 0).map(|x| x * 1).sum()                  
}                                                                               
                                                                                
fn step_2(input: &[i64]) -> i64 {                                               
    // 第 2 步：过滤、映射再求和                                                
    input.iter().filter(|x| **x % 3 == 0).map(|x| x * 2).sum()                  
}                                                                               
                                                                                
fn step_3(input: &[i64]) -> i64 {                                               
    // 第 3 步：过滤、映射再求和                                                
    input.iter().filter(|x| **x % 4 == 0).map(|x| x * 3).sum()                  
}                                                                               
                                                                                
